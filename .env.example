# Copy file này thành .env.local rồi điền API key.
# Nếu để trống, app sẽ chạy ở CHẾ ĐỘ DEMO (trả về dữ liệu giả lập).

# Lấy key miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Rate limit (proxy.ts) – bỏ trống để dùng giá trị mặc định ----
# Số lần gọi AI tối đa mỗi IP trong 1 phút (mặc định 8)
RATE_LIMIT_AI_PER_MINUTE=
# Số lần gọi AI tối đa mỗi IP trong 24 giờ (mặc định 150)
RATE_LIMIT_AI_PER_DAY=
# Tổng số lần gọi AI của TOÀN server trong 1 phút, mọi IP cộng lại (mặc định 120)
RATE_LIMIT_AI_GLOBAL_PER_MINUTE=
# Giới hạn cho các API khác, mỗi IP / 1 phút (mặc định 60)
RATE_LIMIT_API_PER_MINUTE=
