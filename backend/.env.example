PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/tram-sac-ngu-van
# Đổi thành chuỗi ngẫu nhiên dài khi deploy (vd: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Origin của frontend Next.js, nhiều origin ngăn cách bằng dấu phẩy.
# Production (Vercel) vẫn được phép trong code; thêm vào đây nếu có domain riêng.
CORS_ORIGIN=http://localhost:3000,https://tramsacnguvan.vercel.app
# Mã giáo viên nhập lúc đăng ký tài khoản role teacher. Đổi trước khi đưa lên môi trường thật.
TEACHER_SECRET_CODE=cotra-giaovien

# Đánh giá năng lực học sinh (POST /api/teacher/ai-evaluate). Chỉ cần một trong hai key.
# Ưu tiên Gemini. Để trống cả hai thì API trả bản nhận xét sơ bộ từ vở nháp.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
