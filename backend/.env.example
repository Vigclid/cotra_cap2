PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/tram-sac-ngu-van
# Đổi thành chuỗi ngẫu nhiên dài khi deploy (vd: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Origin của frontend Next.js, nhiều origin ngăn cách bằng dấu phẩy
CORS_ORIGIN=http://localhost:3000
# Mã giáo viên nhập lúc đăng ký tài khoản role teacher. Đổi trước khi đưa lên môi trường thật.
TEACHER_SECRET_CODE=cotra-giaovien
